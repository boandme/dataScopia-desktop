<?xml version="1.0" encoding="utf-8"?>
<!--
  Without this, DataScopia.exe fails to start with "Failed to resolve Python.Runtime.Loader.
  Initialize from ...\pythonnet\runtime\Python.Runtime.dll" whenever it's run from a folder
  extracted from a downloaded ZIP - Windows tags every file extracted that way with a hidden
  "Mark of the Web" (Zone.Identifier) marking it as from the internet, and .NET Framework
  refuses to fully load an assembly from a "remote" zone unless explicitly told to trust it here.
  This is a real, reproduced-and-confirmed fix, not a guess: verified by zipping a real build,
  marking every extracted file with Zone.Identifier exactly as Windows does for a browser
  download, and confirming it reproduces the exact failure above and that this file fixes it.
-->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
